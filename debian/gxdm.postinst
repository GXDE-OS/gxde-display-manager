#!/bin/sh
set -e

. /usr/share/debconf/confmodule

THIS_PACKAGE=gxdm
DEFAULT_DISPLAY_MANAGER_FILE=/etc/X11/default-display-manager
DEFAULT_SERVICE=/etc/systemd/system/display-manager.service

if [ "$1" = "configure" ] && [ -z "$DPKG_ROOT" ]; then
    if command -v systemd-sysusers >/dev/null 2>&1; then
        systemd-sysusers gxdm.conf
    elif ! getent passwd gxdm >/dev/null; then
        addgroup --system gxdm
        adduser --system --ingroup gxdm --home /var/lib/gxdm --no-create-home gxdm
        usermod -c "GXDM Greeter Account" gxdm
        usermod -s "/bin/false"           gxdm
    fi

    if command -v systemd-tmpfiles >/dev/null 2>&1; then
        systemd-tmpfiles --create gxdm.conf || true
    fi

    # 没有 systemd-tmpfiles 时自己建状态目录。
    # Create the state directory ourselves when systemd-tmpfiles is unavailable.
    if [ ! -d /var/lib/gxdm ]; then
        mkdir -p /var/lib/gxdm
        chown gxdm:gxdm /var/lib/gxdm
        chmod 0750      /var/lib/gxdm
    fi
fi

if [ ! -e "$DEFAULT_DISPLAY_MANAGER_FILE" ]; then
    if db_get shared/default-x-display-manager; then
        if [ -z "$RET" ]; then
            RET="$THIS_PACKAGE"
        fi
        if [ "$THIS_PACKAGE" != "$RET" ]; then
            echo "Please be sure to run \"dpkg --configure $RET\"."
        fi
        if db_get "$RET"/daemon_name; then
            echo "$RET" > "$DEFAULT_DISPLAY_MANAGER_FILE"
        fi
    fi
fi

# remove the displaced old default display manager file if it exists
if [ -e "$DEFAULT_DISPLAY_MANAGER_FILE.dpkg-tmp" ]; then
    rm "$DEFAULT_DISPLAY_MANAGER_FILE.dpkg-tmp"
fi

db_stop || true

if [ "$1" = "configure" ]; then
    invoke-rc.d dbus reload || true
fi

if [ "$1" = "configure" ] && [ -d /etc/systemd/system/ ]; then
    if [ -e "$DEFAULT_DISPLAY_MANAGER_FILE" ]; then
        NAME=$(basename "$(cat "$DEFAULT_DISPLAY_MANAGER_FILE")")
        SERVICE=
        for dir in /usr/lib/systemd/system /lib/systemd/system; do
            if [ -e "$dir/$NAME.service" ]; then
                SERVICE="$dir/$NAME.service"
                break
            fi
        done
        if [ -h "$DEFAULT_SERVICE" ] && [ "$(readlink "$DEFAULT_SERVICE")" = /dev/null ]; then
            echo "Display manager service is masked" >&2
        elif [ -n "$SERVICE" ]; then
            ln -sf "$SERVICE" "$DEFAULT_SERVICE"
        else
            echo "ERROR: $NAME is the selected default display manager but its unit does not exist" >&2
        fi
    fi
fi

#DEBHELPER#

exit 0
