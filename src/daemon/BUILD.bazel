load(
    "//bazel/qt:qt.bzl",
    "gxdm_configure_file",
    "qt_cc_binary",
    "qt_dbus_adaptor",
    "qt_dbus_interface",
    "qt_moc",
    "qt_moc_cpp",
)

package(default_visibility = ["//visibility:public"])

# config.h (SDDM_INITIAL_VT).
gxdm_configure_file(
    name = "config_h",
    src = "config.h.in",
    out = "config.h",
)

# D-Bus adaptors
_adaptors = [
    qt_dbus_adaptor(
        name = "gen_displaymanageradaptor",
        xml = "//data/interfaces:org.freedesktop.DisplayManager.xml",
        parent_header = "DisplayManager.h",
        parent_class = "SDDM::DisplayManager",
        basename = "displaymanageradaptor",
    ),
    qt_dbus_adaptor(
        name = "gen_seatadaptor",
        xml = "//data/interfaces:org.freedesktop.DisplayManager.Seat.xml",
        parent_header = "DisplayManager.h",
        parent_class = "SDDM::DisplayManagerSeat",
        basename = "seatadaptor",
    ),
    qt_dbus_adaptor(
        name = "gen_sessionadaptor",
        xml = "//data/interfaces:org.freedesktop.DisplayManager.Session.xml",
        parent_header = "DisplayManager.h",
        parent_class = "SDDM::DisplayManagerSession",
        basename = "sessionadaptor",
    ),
]

# D-Bus interfaces (login1)
_interfaces = [
    qt_dbus_interface(
        name = "gen_login1manager",
        xml = "//data/interfaces:org.freedesktop.login1.Manager.xml",
        basename = "Login1Manager",
        includes = ["LogindDBusTypes.h"],
    ),
    qt_dbus_interface(
        name = "gen_login1seat",
        xml = "//data/interfaces:org.freedesktop.login1.Seat.xml",
        basename = "Login1Seat",
        includes = ["LogindDBusTypes.h"],
    ),
    qt_dbus_interface(
        name = "gen_login1session",
        xml = "//data/interfaces:org.freedesktop.login1.Session.xml",
        basename = "Login1Session",
        includes = ["LogindDBusTypes.h"],
    ),
]

# moc the generated D-Bus headers
_dbus_moc = qt_moc(
    name = "dbus_moc",
    hdrs = [
        "displaymanageradaptor.h",
        "seatadaptor.h",
        "sessionadaptor.h",
        "Login1Manager.h",
        "Login1Seat.h",
        "Login1Session.h",
    ],
)

# SeatManager.cpp defines a Q_OBJECT and #include "SeatManager.moc".
_cpp_moc_lib = qt_moc_cpp(
    name = "daemon_cppmoc",
    srcs = ["SeatManager.cpp"],
)

qt_cc_binary(
    name = "gxdm",
    srcs = [
        "DaemonApp.cpp",
        "Display.cpp",
        "DisplayManager.cpp",
        "DisplayServer.cpp",
        "LogindDBusTypes.cpp",
        "Greeter.cpp",
        "PowerManager.cpp",
        "Seat.cpp",
        "SeatManager.cpp",
        "SocketServer.cpp",
        "XorgDisplayServer.cpp",
        "XorgUserDisplayServer.cpp",
        "WaylandDisplayServer.cpp",
        # generated headers (needed as inputs)
        "config.h",
        "displaymanageradaptor.h",
        "seatadaptor.h",
        "sessionadaptor.h",
        "Login1Manager.h",
        "Login1Seat.h",
        "Login1Session.h",
    ] + glob(["*.h"]) + _adaptors + _interfaces + _dbus_moc,
    moc_hdrs = [
        "DaemonApp.h",
        "Display.h",
        "DisplayManager.h",
        "DisplayServer.h",
        "Greeter.h",
        "PowerManager.h",
        "Seat.h",
        "SeatManager.h",
        "SocketServer.h",
        "XorgDisplayServer.h",
        "XorgUserDisplayServer.h",
        "WaylandDisplayServer.h",
    ],
    linkopts = [
        "-lxcb",
        "-lXau",
    ],
    deps = [
        _cpp_moc_lib,
        "//src/auth:auth",
        "//src/common:common",
    ],
)
