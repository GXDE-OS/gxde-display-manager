load("//bazel/qt:qt.bzl", "qt_cc_binary", "qt_moc_textual", "qt_rcc")

package(default_visibility = ["//visibility:public"])

# KeyboardModel.cpp does `#include "moc_KeyboardModel.cpp"` itself
_keyboardmodel_moc = qt_moc_textual(
    name = "keyboardmodel_moc",
    hdrs = ["KeyboardModel.h"],
)

# Compile the embedded default theme into the greeter
_theme_rcc = qt_rcc(
    name = "theme_rcc",
    qrc = "theme.bazel.qrc",
    data = [
        "theme/angle-down.png",
        "theme/angle-left.png",
        "theme/angle-right.png",
        "theme/background.png",
        "theme/Main.qml",
        "theme/reboot.png",
        "theme/shutdown.png",
        "theme/metadata.desktop",
        "theme/theme.conf",
    ],
    init_name = "theme",
)

qt_cc_binary(
    name = "gxdm-greeter-qt6",
    srcs = [
        "GreeterApp.cpp",
        "GreeterProxy.cpp",
        "KeyboardLayout.cpp",
        "KeyboardModel.cpp",
        "ScreenModel.cpp",
        "SessionModel.cpp",
        "UserModel.cpp",
        "waylandkeyboardbackend.cpp",
        "XcbKeyboardBackend.cpp",
        _theme_rcc,
    ] + glob(["*.h"]),
    linkopts = [
        "-lxcb",
        "-lxcb-xkb",
        "-lxkbcommon",
    ],
    moc_hdrs = [
        "GreeterApp.h",
        "GreeterProxy.h",
        "KeyboardLayout.h",
        "ScreenModel.h",
        "SessionModel.h",
        "UserModel.h",
    ],
    deps = [
        _keyboardmodel_moc,
        "//src/common:common",
    ],
)
