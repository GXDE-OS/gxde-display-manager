<!DOCTYPE RCC><RCC version="1.0">
<qresource prefix="/theme">
    <file alias="angle-down.png">theme/angle-down.png</file>
    <file alias="angle-left.png">theme/angle-left.png</file>
    <file alias="angle-right.png">theme/angle-right.png</file>
    <file alias="background.png">theme/background.png</file>
    <file alias="Main.qml">theme/Main.qml</file>
    <file alias="reboot.png">theme/reboot.png</file>
    <file alias="shutdown.png">theme/shutdown.png</file>
    <file alias="metadata.desktop">theme/metadata.desktop</file>
    <file alias="theme.conf">theme/theme.conf</file>
</qresource>
</RCC>
