load("@rules_cc//cc:defs.bzl", "cc_library")
load("//bazel/qt:qt.bzl", "qt_cc_binary", "qt_rcc")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "neo_backend",
    srcs = [
        "vendor/src/backend/sessions/sessions.cc",
        "vendor/src/backend/users/users.cc",
        "vendor/src/utils/logger/logger.cc",
    ],
    hdrs = [
        "vendor/src/backend/global_def/global.h",
        "vendor/src/backend/sessions/sessions.h",
        "vendor/src/backend/users/users.h",
        "vendor/src/utils/logger/ansi_escape_code_def.h",
        "vendor/src/utils/logger/logger.h",
    ],
    copts = ["-std=c++20"],
    includes = ["vendor"],
)

_neo_resources = [
    qt_rcc(
        name = "rcc_image",
        qrc = "image.qrc",
        data = glob(["img/**"]),
        init_name = "image",
    ),
    qt_rcc(
        name = "rcc_logintheme",
        qrc = "logintheme.qrc",
        data = glob([
            "theme/**",
            "skin/**",
        ]),
        init_name = "logintheme",
    ),
    qt_rcc(
        name = "rcc_widgetsimages",
        qrc = "widgets/widgetsimages.qrc",
        data = glob(["widgets/img/**"]),
        init_name = "widgetsimages",
    ),
    qt_rcc(
        name = "rcc_widgetstheme",
        qrc = "widgets/widgetstheme.qrc",
        data = glob(["widgets/skin/**"]),
        init_name = "widgetstheme",
    ),
]

qt_cc_binary(
    name = "gxdm-greeter-neo",
    srcs = glob([
        "*.cpp",
        "*.h",
        "view/*.cpp",
        "view/*.h",
        "global_util/*.cpp",
        "global_util/*.h",
        "global_util/dbus/*.cpp",
        "global_util/dbus/*.h",
        "widgets/*.cpp",
        "widgets/*.h",
        "session_widgets/*.cpp",
        "session_widgets/*.h",
    ]) + [
        "vendor/src/backend/users/users.cc",
        "vendor/src/backend/users/users.h",
        "vendor/src/backend/sessions/sessions.cc",
        "vendor/src/backend/sessions/sessions.h",
        "vendor/src/backend/global_def/global.h",
        "vendor/src/utils/logger/logger.cc",
        "vendor/src/utils/logger/logger.h",
        "vendor/src/utils/logger/ansi_escape_code_def.h",
    ] + _neo_resources,
    copts = ["-std=c++20"],
    includes = [
        ".",
        "global_util",
        "global_util/dbus",
        "session_widgets",
        "vendor",
        "view",
        "widgets",
    ],
    linkopts = [
        "-lX11",
        "-lXi",
        "-lXtst",
        "-lXcursor",
        "-lXfixes",
        "-lXrandr",
        "-lXext",
    ],
    # Only headers that actually carry Q_OBJECT (mirrors CMake AUTOMOC).
    moc_hdrs = [
        "greeterworker.h",
        "loginwindow.h",
        "view/logowidget.h",
        "global_util/multiscreenmanager.h",
        "global_util/dbus/dbuscontrolcenter.h",
        "global_util/dbus/dbusdisplaymanager.h",
        "global_util/dbus/dbushotzone.h",
        "global_util/dbus/dbusinputdevices.h",
        "global_util/dbus/dbuskeyboard.h",
        "global_util/dbus/dbuslockfront.h",
        "global_util/dbus/dbuslockservice.h",
        "global_util/dbus/dbuslogin1manager.h",
        "global_util/dbus/dbusmediaplayer2.h",
        "global_util/dbus/dbussessionmanager.h",
        "global_util/dbus/displayinterface.h",
        "session_widgets/authinterface.h",
        "session_widgets/framedatabind.h",
        "session_widgets/lockcontent.h",
        "session_widgets/lockpasswordwidget.h",
        "session_widgets/sessionbasemodel.h",
        "session_widgets/sessionbasewindow.h",
        "session_widgets/userframe.h",
        "session_widgets/userinfo.h",
        "session_widgets/userinputwidget.h",
        "widgets/controlwidget.h",
        "widgets/dbreathinglabel.h",
        "widgets/errortooltip.h",
        "widgets/fullscreenbackground.h",
        "widgets/kblayoutwidget.h",
        "widgets/keyboardmonitor.h",
        "widgets/loginbutton.h",
        "widgets/mediawidget.h",
        "widgets/neoarrowrectangle.h",
        "widgets/otheruserinput.h",
        "widgets/propertygroup.h",
        "widgets/rounditembutton.h",
        "widgets/sessionwidget.h",
        "widgets/shutdownwidget.h",
        "widgets/useravatar.h",
        "widgets/userbreathinglabel.h",
        "widgets/userbutton.h",
        "widgets/virtualkbinstance.h",
    ],
    deps = ["//bazel/qt:dtk"],
)
