load("//bazel/qt:qt.bzl", "qt_cc_binary", "qt_cc_library", "qt_qml_module", "qt_rcc")

package(default_visibility = ["//visibility:public"])

qt_cc_library(
    name = "greeter_neo",
    srcs = [
        "src/greeter_backend.cc",
        "src/screen_manager.cc",
        "src/session_list.cc",
    ],
    hdrs = [
        "src/greeter_backend.h",
        "src/screen_manager.h",
        "src/session_list.h",
        "src/utils/macros.h",
    ],
    includes = [".."],
    moc_hdrs = [
        "src/greeter_backend.h",
        "src/screen_manager.h",
    ],
    deps = ["//src/common"],
)

qt_cc_binary(
    name = "gxdm-greeter-neo",
    srcs = [
        "src/main.cc",
        qt_rcc(
            name = "rcc_resources",
            qrc = "res/resources.qrc",
            data = glob(["res/**"], exclude = ["res/resources.qrc"]),
            init_name = "resources",
        ),
        qt_qml_module(
            name = "qml_greeter",
            uri = "Greeter",
            version = "1.0",
            qml_files = [
                "qml/MainWindow.qml",
                "qml/components/UserSelecter.qml",
                "qml/components/PasswordCard.qml",
                "qml/components/UserAvatar.qml",
                "qml/components/VirtualKeyboardPanel.qml",
                "qml/components/DtkFrame.qml",
                "qml/components/SessionMenu.qml",
                "qml/components/PowerMenu.qml",
            ],
            init_name = "greeter_qml",
        ),
    ],
    deps = [
        ":greeter_neo",
        "//src/common:greeter_appearance",
    ],
)
