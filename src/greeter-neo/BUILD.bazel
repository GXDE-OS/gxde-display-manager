load("//bazel/qt:qt.bzl", "qt_cc_binary", "qt_cc_library", "qt_rcc")

package(default_visibility = ["//visibility:public"])

# Headers shared by the greeter and the lock screen that carry Q_OBJECT and must
# be moc'd. moc'd once here (in neo_common) to avoid duplicate moc_*.cpp outputs
# that would clash if both binaries moc'd the same headers.
_COMMON_MOC_HDRS = [
    "view/logowidget.h",
    "global_util/multiscreenmanager.h",
    "global_util/dbus/dbuscontrolcenter.h",
    "global_util/dbus/dbusdisplaymanager.h",
    "global_util/dbus/dbushotzone.h",
    "global_util/dbus/dbusinputdevices.h",
    "global_util/dbus/dbuskeyboard.h",
    "global_util/dbus/dbuslockfront.h",
    "global_util/dbus/dbuslockservice.h",
    "global_util/dbus/dbuslogin1manager.h",
    "global_util/dbus/dbusmediaplayer2.h",
    "global_util/dbus/dbussessionmanager.h",
    "global_util/dbus/displayinterface.h",
    "session_widgets/authinterface.h",
    "session_widgets/framedatabind.h",
    "session_widgets/lockcontent.h",
    "session_widgets/lockpasswordwidget.h",
    "session_widgets/sessionbasemodel.h",
    "session_widgets/sessionbasewindow.h",
    "session_widgets/userframe.h",
    "session_widgets/userinfo.h",
    "session_widgets/userinputwidget.h",
    "widgets/controlwidget.h",
    "widgets/dbreathinglabel.h",
    "widgets/dpasswdeditanimatedse.h",
    "widgets/errortooltip.h",
    "widgets/fullscreenbackground.h",
    "widgets/kblayoutwidget.h",
    "widgets/keyboardmonitor.h",
    "widgets/loginbutton.h",
    "widgets/mediawidget.h",
    "widgets/neoarrowrectangle.h",
    "widgets/otheruserinput.h",
    "widgets/propertygroup.h",
    "widgets/rounditembutton.h",
    "widgets/sessionindicator.h",
    "widgets/sessionwidget.h",
    "widgets/shutdownwidget.h",
    "widgets/useravatar.h",
    "widgets/userbreathinglabel.h",
    "widgets/userbutton.h",
    "widgets/virtualkbinstance.h",
]

_INCLUDES = [
    ".",
    "global_util",
    "global_util/dbus",
    "widgets",
    "session_widgets",
    "view",
    "vendor",
]

# X11 libs needed by keyboardmonitor (common), the greeter main and the locker.
_X11_LINKOPTS = [
    "-lX11",
    "-lXi",
    "-lXtst",
    "-lXcursor",
    "-lXfixes",
    "-lXrandr",
    "-lXext",
    "-lxcb",
]

# --- Shared code (widgets / session_widgets / global_util / view / vendor) ----
qt_cc_library(
    name = "neo_common",
    srcs = glob([
        "view/*.cpp",
        "global_util/*.cpp",
        "global_util/dbus/*.cpp",
        "widgets/*.cpp",
        "session_widgets/*.cpp",
    ]) + [
        "vendor/src/backend/users/users.cc",
        "vendor/src/backend/sessions/sessions.cc",
        "vendor/src/utils/logger/logger.cc",
    ],
    hdrs = glob([
        "global_util/*.h",
        "global_util/dbus/*.h",
        "widgets/*.h",
        "session_widgets/*.h",
        "view/*.h",
    ]) + [
        "vendor/src/backend/users/users.h",
        "vendor/src/backend/sessions/sessions.h",
        "vendor/src/backend/global_def/global.h",
        "vendor/src/utils/logger/logger.h",
        "vendor/src/utils/logger/ansi_escape_code_def.h",
    ],
    copts = ["-std=c++20"],
    includes = _INCLUDES,
    linkopts = _X11_LINKOPTS,
    moc_hdrs = _COMMON_MOC_HDRS,
    deps = ["//bazel/qt:dtk"],
)

# Shared widgets resources (compiled into each binary; a static-lib rcc would be
# dead-stripped, so keep them in the executables).
_WIDGET_RCC = [
    qt_rcc(
        name = "rcc_widgetsimages",
        qrc = "widgets/widgetsimages.qrc",
        data = glob(["widgets/img/**"]),
        init_name = "widgetsimages",
    ),
    qt_rcc(
        name = "rcc_widgetstheme",
        qrc = "widgets/widgetstheme.qrc",
        data = glob(["widgets/skin/**"]),
        init_name = "widgetstheme",
    ),
]

# --- Greeter (talks to the GXDM daemon over --socket) ------------------------
qt_cc_binary(
    name = "gxdm-greeter-neo",
    srcs = [
        "main.cpp",
        "loginwindow.cpp",
        "loginwindow.h",
        "greeterworker.cpp",
        "greeterworker.h",
        qt_rcc(name = "rcc_image", qrc = "image.qrc", data = glob(["img/**"]), init_name = "image"),
        qt_rcc(name = "rcc_logintheme", qrc = "logintheme.qrc", data = glob(["theme/**", "skin/**"]), init_name = "logintheme"),
    ] + _WIDGET_RCC,
    copts = ["-std=c++20"],
    includes = _INCLUDES,
    moc_hdrs = [
        "greeterworker.h",
        "loginwindow.h",
    ],
    deps = [":neo_common"],
)

# --- Lock screen (in-session, authenticates via PAM directly) ----------------
qt_cc_binary(
    name = "gxdm-lock-neo",
    srcs = glob([
        "lock/*.cpp",
        "lock/*.h",
        "lock/dbus/*.cpp",
        "lock/dbus/*.h",
    ]) + [
        qt_rcc(name = "rcc_lock_images", qrc = "lock/images.qrc", data = glob(["lock/fonts/**"]), init_name = "lock_images"),
        qt_rcc(name = "rcc_lock_logintheme", qrc = "lock/logintheme.qrc", data = glob(["lock/theme/**", "lock/skin/**"]), init_name = "lock_logintheme"),
    ] + _WIDGET_RCC,
    copts = ["-std=c++20"],
    includes = _INCLUDES + ["lock"],
    moc_hdrs = [
        "lock/lockworker.h",
        "lock/lockshortcutmanager.h",
        "lock/lockframe.h",
        "lock/timewidget.h",
        "lock/freedesktopscreensaver.h",
        "lock/dbus/dbuslockfrontservice.h",
        "lock/dbus/dbuslockagent.h",
    ],
    # //src/auth:auth (+ //src/common) provides GXDM's own authenticator; the
    # locker reuses it in auth-only mode instead of doing PAM/logind itself.
    deps = [
        ":neo_common",
        "//src/auth:auth",
    ],
)
