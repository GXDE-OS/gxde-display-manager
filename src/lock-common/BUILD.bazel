load("//bazel/qt:qt.bzl", "qt_cc_library")

package(default_visibility = ["//visibility:public"])

# Mirrors src/lock-common/CMakeLists.txt. The session model and the lock
# backend (PAM worker, D-Bus surface, Wayland session lock) still live in
# src/greeter-classic and are exposed there as :neo_common and :lock_backend.

# Lock screen style resolution and the exec handoff. No widget dependencies,
# so the daemon links it too.
qt_cc_library(
    name = "lock_style",
    srcs = ["lockstyle.cpp"],
    hdrs = ["lockstyle.h"],
    copts = ["-std=c++20"],
    deps = ["//src/common:constants"],
)

# Watches the configured style and requests a locker handoff after unlock.
qt_cc_library(
    name = "lock_style_manager",
    srcs = ["lockstylemanager.cpp"],
    hdrs = ["lockstylemanager.h"],
    moc_hdrs = ["lockstylemanager.h"],
    copts = ["-std=c++20"],
    deps = [
        ":lock_style",
        "//src/greeter-classic:neo_common",
    ],
)

# QML-facing facade and user carousel model used by gxdm-lock-neo.
qt_cc_library(
    name = "lock_common",
    srcs = [
        "lockbackend.cpp",
        "userlistmodel.cpp",
    ],
    hdrs = [
        "lockbackend.h",
        "userlistmodel.h",
    ],
    moc_hdrs = [
        "lockbackend.h",
        "userlistmodel.h",
    ],
    copts = ["-std=c++20"],
    deps = [
        ":lock_style_manager",
        "//src/greeter-classic:lock_backend",
    ],
)
