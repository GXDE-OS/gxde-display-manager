"""System Qt6 linking local repository."""

package(default_visibility = ["//visibility:public"])

# Convenience alias so the rest of the repo refers to //bazel/qt:qt6.
alias(
    name = "qt6",
    actual = "@qt6_system//:qt6",
)

# Host DTK (Qt6 port). Headers-only; depend on it together with :qt6.
alias(
    name = "dtk",
    actual = "@dtk_system//:dtk",
)

exports_files(["qt.bzl", "constants.bzl"])
