load("@rules_pkg//pkg:mappings.bzl", "pkg_files")
load("//bazel/qt:qt.bzl", "gxdm_configure_file")

package(default_visibility = ["//visibility:public"])

_QMLDIR = "/usr/lib/x86_64-linux-gnu/qt6/qml/GxdmComponents"

# LayoutBox.qml references ${DATA_INSTALL_DIR}; configure it.
gxdm_configure_file(
    name = "layoutbox_qml",
    src = "2.0/LayoutBox.qml",
    out = "LayoutBox.qml",
)

pkg_files(
    name = "components_pkg",
    srcs = glob(
        ["2.0/*.qml"],
        exclude = ["2.0/LayoutBox.qml"],
    ) + glob(["common/*"]) + [":layoutbox_qml"],
    # Flatten 2.0/ and common/ into the module dir (CMake installs their contents).
    prefix = _QMLDIR,
    renames = {
        "2.0/Background.qml": "Background.qml",
        "2.0/Button.qml": "Button.qml",
        "2.0/Clock.qml": "Clock.qml",
        "2.0/ComboBox.qml": "ComboBox.qml",
        "2.0/ImageButton.qml": "ImageButton.qml",
        "2.0/Menu.qml": "Menu.qml",
        "2.0/PasswordBox.qml": "PasswordBox.qml",
        "2.0/PictureBox.qml": "PictureBox.qml",
        "2.0/TextBox.qml": "TextBox.qml",
        "common/TextConstants.qml": "TextConstants.qml",
        "common/qmldir": "qmldir",
        "common/warning.png": "warning.png",
    },
)
