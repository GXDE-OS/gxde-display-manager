load("@rules_pkg//pkg:mappings.bzl", "pkg_attributes", "pkg_files")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")

package(default_visibility = ["//visibility:public"])

# Main binaries goes to /usr/bin.
pkg_files(
    name = "bin_pkg",
    srcs = [
        "//src/daemon:gxdm",
        "//src/greeter:gxdm-greeter-qt6",
        # Default greeter
        "//src/greeter-neo:gxdm-greeter-neo",
        # In-session lock screen (PAM-direct, no dde-daemon)
        "//src/greeter-neo:gxdm-lock-neo",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/bin",
)

# Helper binaries goes to /usr/libexec.
pkg_files(
    name = "libexec_pkg",
    srcs = [
        "//src/helper:gxdm-helper",
        "//src/helper:gxdm-helper-start-wayland",
        "//src/helper:gxdm-helper-start-x11user",
    ],
    attributes = pkg_attributes(mode = "0755"),
    prefix = "/usr/libexec",
)

# Full deployable install tree, extracted at / on the target.
pkg_tar(
    name = "gxdm-dist",
    srcs = [
        ":bin_pkg",
        ":libexec_pkg",
        "//components:components_pkg",
        "//data:flags_pkg",
        "//data:faces_pkg",
        "//data:scripts_pkg",
        "//data:themes_pkg",
        "//data:translations_pkg",
        "//data:dbus_pkg",
        "//services:systemd_pkg",
        "//services:sysusers_pkg",
        "//services:tmpfiles_pkg",
        "//services:pam_pkg",
    ],
    extension = "tar",
)
