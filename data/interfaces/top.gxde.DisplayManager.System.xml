<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
    <interface name="top.gxde.DisplayManager.System">
        <method name="SetCursor">
            <arg type="s" name="theme" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaperGXDEDefault">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaperDDELockDefault">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetWallpaper">
            <arg type="h" name="wallpaper" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="ClearWallpaper">
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="SetLockWallpaperOverride">
            <arg type="u" name="uid" direction="in"/>
            <arg type="h" name="wallpaper" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="ClearLockWallpaperOverride">
            <arg type="u" name="uid" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="LockWallpaperOverride">
            <arg type="u" name="uid" direction="in"/>
            <arg type="s" name="wallpaper" direction="out"/>
        </method>
        <method name="SetGreeterDisplayServer">
            <arg type="s" name="displayServer" direction="in"/>
            <arg type="b" name="success" direction="out"/>
        </method>
        <method name="GreeterDisplayServer">
            <arg type="s" name="displayServer" direction="out"/>
        </method>
        <method name="PowerOff"/>
        <method name="Reboot"/>
        <method name="Suspend"/>
        <method name="Hibernate"/>
        <signal name="WallpaperChanged">
            <arg type="s" name="wallpaper"/>
        </signal>
        <signal name="LockWallpaperOverrideChanged">
            <arg type="u" name="uid"/>
            <arg type="s" name="wallpaper"/>
        </signal>
    </interface>
</node>
